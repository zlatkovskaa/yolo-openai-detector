# Local development example only. Do not commit real production secrets.

YOLO_GATEWAY_API_KEY=replace-with-local-development-key

# Stable local model ID exposed by /v1/models and accepted by /v1/chat/completions.
YOLO_GATEWAY_MODEL_ID=yolo-cpu-detector

# Preferred detector model path. Model weights are not committed to the repo.
YOLO_GATEWAY_MODEL_PATH=yolov8n.pt

# Legacy alias retained for compatibility with earlier configs.
# YOLO_GATEWAY_YOLO_MODEL=yolov8n.pt

# Maximum decoded image size in bytes. Keep conservative for CPU-only service.
YOLO_GATEWAY_MAX_IMAGE_BYTES=10485760

# Confidence threshold for detections.
YOLO_GATEWAY_CONFIDENCE_THRESHOLD=0.25

# IoU threshold used by the detector.
YOLO_GATEWAY_IOU_THRESHOLD=0.45

# In v1 the runtime device is CPU-only.
YOLO_GATEWAY_DEVICE=cpu

# Detector input size in pixels.
YOLO_GATEWAY_IMAGE_SIZE=640
